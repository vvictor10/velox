# LLM providers
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Pinned model defaults from fixture assessment
VELOX_NEWS_THEME_MODEL=accounts/fireworks/models/gpt-oss-120b
VELOX_DELTA_MODEL=openai/gpt-oss-120b
VELOX_RISK_MODEL=accounts/fireworks/models/gpt-oss-120b
VELOX_BRIEF_MODEL=accounts/fireworks/models/gpt-oss-120b
VELOX_REVIEWER_MODEL=openai/gpt-oss-120b

# Memory
MEM0_API_KEY=

# Optional tracing and evals
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=velox
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Market / filings / news data
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
SEC_USER_AGENT="Velox Earnings Agent contact@example.com"

# Provider runtime controls
ALPHA_VANTAGE_LIVE_ENABLED=false
ALPHA_VANTAGE_MIN_SECONDS_BETWEEN_CALLS=1.1
ALPHA_VANTAGE_DAILY_REQUEST_BUDGET=25
FINNHUB_LIVE_ENABLED=true
SEC_LIVE_ENABLED=true

# App settings
APP_ENV=local
