flowchart LR
    user[User selects ticker] --> init[Initialize RunState]
    init --> resolve[Resolve company identity]
    resolve --> identityOk{Identity found?}
    identityOk -- no --> badTicker[[Interrupt<br/>ask user to reselect]]

    identityOk -- yes --> memory[Load prior report memory]
    memory --> memoryOk{Memory lookup result}
    memoryOk -- found --> memoryState[Attach prior approved report]
    memoryOk -- missing --> noMemory[Record neutral no-memory state]
    memoryOk -- failed --> memoryWarn[Record lookup_failed warning]

    memoryState --> collect[Collect public evidence]
    noMemory --> collect
    memoryWarn --> collect

    collect --> providerStatus{Tool failed?}
    providerStatus -- recoverable --> retry[Retry once]
    retry --> retryOk{Recovered?}
    retryOk -- yes --> evidence[Assemble Evidence Pack]
    retryOk -- no --> fallback[Use fallback or disclose gap]
    providerStatus -- no --> evidence
    fallback --> evidence

    evidence --> evidenceOk{Minimum evidence met?}
    evidenceOk -- no --> weakStop[[Stop before draft<br/>show missing evidence]]
    evidenceOk -- yes --> themes[News Theme Agent<br/>structured JSON]
    themes --> themesOk{Valid output?}
    themesOk -- no --> themesGap[Disclose skipped themes]
    themesOk -- yes --> delta[Delta Agent<br/>current vs memory]
    themesGap --> delta

    delta --> deltaOk{Valid output?}
    deltaOk -- no --> deltaGap[Disclose skipped delta]
    deltaOk -- yes --> risk[Risk Analyst Agent<br/>risks + watch items]
    deltaGap --> risk

    risk --> riskOk{Valid output?}
    riskOk -- no --> riskGap[Disclose skipped risk analysis]
    riskOk -- yes --> draft[Brief Drafter Agent<br/>cited report JSON]
    riskGap --> draft

    draft --> draftOk{Draft valid?}
    draftOk -- no --> draftRetry[Retry draft once]
    draftRetry --> draft
    draftOk -- exhausted --> draftStop[[Stop before approval]]
    draftOk -- yes --> review[Reviewer Agent<br/>citations + warnings + safety]

    review --> reviewOk{Review passed?}
    reviewOk -- citation repairable --> repair[Repair citation metadata]
    repair --> review
    reviewOk -- content repairable --> revise[Revise draft once]
    revise --> review
    reviewOk -- no --> blocked[[Block approval<br/>show reviewer findings]]
    reviewOk -- yes --> human[[Await Human Review Gate]]

    human --> approved{User approves save?}
    approved -- no --> noSave[End without write]
    approved -- yes --> save[Save approved report<br/>Mem0 + local mirror]
    save --> done[Run complete]
    noSave --> done

    subgraph State["RunState carried across every node"]
      stateFields["ticker, company, run id, progress, evidence, citations, tool ledger, retry/fallback records, memory status, agent outputs, reviewer findings, telemetry, approval status"]
    end

    init -. writes .-> State
    resolve -. writes .-> State
    memory -. writes .-> State
    memoryWarn -. writes .-> State
    collect -. writes .-> State
    fallback -. writes .-> State
    evidence -. writes .-> State
    themes -. writes .-> State
    delta -. writes .-> State
    risk -. writes .-> State
    draft -. writes .-> State
    review -. writes .-> State
    human -. pauses .-> State
    save -. writes .-> State

    classDef input fill:#f8fafc,stroke:#475569,color:#0f172a
    classDef control fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
    classDef tool fill:#ecfdf5,stroke:#059669,color:#064e3b
    classDef llm fill:#ede9fe,stroke:#7c3aed,color:#3b0764
    classDef decision fill:#fff7ed,stroke:#ea580c,color:#7c2d12
    classDef interrupt fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
    classDef memoryClass fill:#fdf2f8,stroke:#db2777,color:#831843
    classDef output fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef state fill:#ecfeff,stroke:#0891b2,color:#164e63,stroke-dasharray: 5 5

    class user input
    class init,resolve,collect,retry,fallback,evidence,themesGap,deltaGap,riskGap,draftRetry,repair,revise control
    class memory,memoryState,noMemory,memoryWarn,save memoryClass
    class themes,delta,risk,draft,review llm
    class identityOk,memoryOk,providerStatus,retryOk,evidenceOk,themesOk,deltaOk,riskOk,draftOk,reviewOk,approved decision
    class badTicker,weakStop,draftStop,blocked,human interrupt
    class noSave,done output
    class State,stateFields state
