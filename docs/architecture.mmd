flowchart LR
    user[User<br/>selects ticker] --> ui[Streamlit UI<br/>local typeahead<br/>progress + report tabs]
    ui --> graph[LangGraph Orchestrator<br/>stateful control flow<br/>retries + fallbacks<br/>human boundary]

    graph --> state[(RunState<br/>ticker + company<br/>evidence + warnings<br/>tool ledger + telemetry<br/>approval status)]

    graph --> tools{{Public Tool Layer}}
    tools --> ticker[Local SEC Ticker Cache<br/>fast search<br/>ticker + company + CIK]
    tools --> sec[SEC EDGAR<br/>submissions<br/>company facts]
    tools --> alpha[Alpha Vantage<br/>optional earnings/news<br/>paced + budget aware]
    tools --> finnhub[Finnhub<br/>baseline + fallback<br/>earnings + news]
    tools --> memRead[Mem0 Lookup<br/>prior approved report]

    ticker --> evidence[Evidence Pack<br/>normalized records<br/>run-scoped citations<br/>freshness + gaps]
    sec --> evidence
    alpha --> evidence
    finnhub --> evidence
    memRead --> evidence
    evidence --> gate{Minimum evidence met?}

    gate -- no --> stop[[Stop / interrupt<br/>explain missing evidence]]
    gate -- yes --> llm{{LLM Agent Layer<br/>curated prompts<br/>JSON schemas<br/>model + prompt telemetry}}

    llm --> themes[News Theme Agent]
    llm --> delta[Delta Agent]
    themes --> risk[Risk Analyst Agent]
    delta --> risk
    risk --> draft[Brief Drafter Agent]
    draft --> reviewer[Reviewer Agent<br/>citations + warnings<br/>schema + safety]

    reviewer --> reviewOk{Reviewer passed?}
    reviewOk -- repairable --> repair[Auto repair / revise once]
    repair --> reviewer
    reviewOk -- no --> blocked[[Block approval<br/>show reviewer findings]]
    reviewOk -- yes --> gateHuman[[Human Review Gate<br/>user approves save]]

    gateHuman -- not approved --> noWrite[End without write]
    gateHuman -- approved --> memWrite[Mem0 Save<br/>local JSON mirror<br/>one current report per ticker]
    memWrite --> complete[Run complete]
    noWrite --> complete

    graph -. traces .-> langsmith[LangSmith<br/>graph + tool + LLM spans<br/>eval evidence]
    tools -. results .-> state
    evidence -. citations .-> state
    reviewer -. findings .-> state
    gateHuman -. pause .-> state

    classDef input fill:#f8fafc,stroke:#475569,color:#0f172a
    classDef uiClass fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
    classDef control fill:#e0f2fe,stroke:#0369a1,color:#0c4a6e
    classDef tool fill:#ecfdf5,stroke:#059669,color:#064e3b
    classDef memory fill:#fdf2f8,stroke:#db2777,color:#831843
    classDef evidenceClass fill:#fefce8,stroke:#ca8a04,color:#713f12
    classDef llmClass fill:#ede9fe,stroke:#7c3aed,color:#3b0764
    classDef decision fill:#fff7ed,stroke:#ea580c,color:#7c2d12
    classDef interrupt fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
    classDef output fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef obs fill:#f1f5f9,stroke:#64748b,color:#334155,stroke-dasharray: 5 5
    classDef stateClass fill:#ecfeff,stroke:#0891b2,color:#164e63,stroke-dasharray: 5 5

    class user input
    class ui uiClass
    class graph,repair control
    class tools,ticker,sec,alpha,finnhub tool
    class memRead,memWrite memory
    class evidence evidenceClass
    class llm,themes,delta,risk,draft,reviewer llmClass
    class gate,reviewOk decision
    class stop,blocked,gateHuman interrupt
    class noWrite,complete output
    class langsmith obs
    class state stateClass
